rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'c3qEzVVU52NddP2LmNQXAldCZ5C2' ||
        request.auth.uid == 'S41CLovzpAURxejUSkA4W52TNdn1' ||
        request.auth.token.email == 'ds.turki.1@gmail.com' ||
        request.auth.token.email == 'bekrkraft6@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Banned users collection
    match /bannedUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profile collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Courses collections (Edit/Create allowed for all authenticated users; Delete strictly for Admin ONLY)
    match /userCourses/{courseId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /health_courses/{courseId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /business_courses/{courseId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Course Ratings collection
    match /course_ratings/{courseId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.overallRating >= 1 &&
        request.resource.data.overallRating <= 5;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Learning Resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Contribution points and Leaderboard
    match /contributions/{contribId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
